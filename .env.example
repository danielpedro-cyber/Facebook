# ─── Credenciais do Facebook Ads ─────────────────────────────────────────────
#
# 1. Acesse: https://business.facebook.com/settings/system-users
#    (ou use o Explorador da API: https://developers.facebook.com/tools/explorer)
#
# 2. Gere um token com as permissões:
#    ✅ ads_read
#    ✅ ads_management  (opcional, apenas para leitura não é necessário)
#    ✅ business_management
#
# 3. Copie este arquivo como ".env" e preencha com seus dados:
#    cp .env.example .env
#
# ATENÇÃO: Nunca commite o arquivo .env no git!

FB_ACCESS_TOKEN=SEU_TOKEN_AQUI

# ID da conta de anúncios — encontre em:
# Gerenciador de Anúncios > URL do navegador: act_XXXXXXXXXX
# Ou em: Configurações da conta > ID da conta
FB_AD_ACCOUNT_ID=act_XXXXXXXXXX
